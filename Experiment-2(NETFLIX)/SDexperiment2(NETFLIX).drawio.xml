        <mxCell id="9Hf2IJlqMsTZykQ3hl1n-5" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;align=center;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;" value="&lt;h1 style=&quot;margin-top: 0px;&quot; align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Functional Requirements&lt;/font&gt;&lt;/h1&gt;&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Users should be able to create account and login&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Users should be able to search for any movie/show they are looking for&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Users should be provided with suggestions on their dashboard based on what type of content they watch.&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Users should be able to add movies/shows to a wish list or &quot;watch later&quot;&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Users should be able to look at their watch history&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="400" x="280" y="100" as="geometry" />
        </mxCell>
        <mxCell id="9Hf2IJlqMsTZykQ3hl1n-6" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;align=center;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;" value="&lt;h1 style=&quot;margin-top: 0px;&quot; align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Non-Functional Requirements&lt;/font&gt;&lt;/h1&gt;&lt;div align=&quot;center&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;The software/app should be available at all times. (minimal down time)&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;The software should be able to stream movies/shows with minimal latency.&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;The software should be reliable and consistent. It must use the ACID properties of database.&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;User accounts, passwords should be protected from unauthorized access.&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;The interface should be user-friendly and intuitive to use&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="440" x="1026.63" y="100" as="geometry" />
        </mxCell>
        <mxCell id="9Hf2IJlqMsTZykQ3hl1n-9" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;align=center;fillColor=#f5f5f5;strokeColor=#666666;gradientColor=#b3b3b3;" value="&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Back of the envelope estimations&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-- &lt;span data-start=&quot;160&quot; data-end=&quot;185&quot;&gt;2 million daily users&lt;/span&gt;&lt;br&gt;-- Each user roughly watches &lt;span data-start=&quot;217&quot; data-end=&quot;232&quot;&gt;2 hours/day&lt;/span&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-- Average video bitrate = &lt;span data-start=&quot;262&quot; data-end=&quot;272&quot;&gt;5 Mbps&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;span data-start=&quot;262&quot; data-end=&quot;272&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-- &lt;strong data-start=&quot;285&quot; data-end=&quot;305&quot;&gt;Daily video data&lt;/strong&gt; → 2 million x 2 hours × (5/8) MB/s&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;=&amp;gt; 2M × 2 × (5/8) x 3600 MB&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;=&amp;gt; &lt;strong data-start=&quot;424&quot; data-end=&quot;444&quot;&gt;9,000,000 GB/day&lt;/strong&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;=&amp;gt; &lt;strong data-start=&quot;474&quot; data-end=&quot;490&quot;&gt;9 PB per day&lt;/strong&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;strong data-start=&quot;474&quot; data-end=&quot;490&quot;&gt;&lt;br&gt;&lt;/strong&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-- &lt;strong data-start=&quot;503&quot; data-end=&quot;528&quot;&gt;Peak concurrent users&lt;/strong&gt; → 500,000 users&lt;br&gt;-- Each user requires &lt;strong data-start=&quot;569&quot; data-end=&quot;579&quot;&gt;5 Mbps&lt;/strong&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;=&amp;gt; 500,000 x 5 Mbps&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;=&amp;gt; &lt;strong data-start=&quot;655&quot; data-end=&quot;682&quot;&gt;2.5 Tbps peak bandwidth&lt;/strong&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;strong data-start=&quot;655&quot; data-end=&quot;682&quot;&gt;&lt;br&gt;&lt;/strong&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-- &lt;strong data-start=&quot;695&quot; data-end=&quot;711&quot;&gt;API requests&lt;/strong&gt; → 2 million users x 20 requests/day&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;=&amp;gt; &lt;strong data-start=&quot;777&quot; data-end=&quot;808&quot;&gt;40 million requests per day&lt;/strong&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;strong data-start=&quot;777&quot; data-end=&quot;808&quot;&gt;&lt;br&gt;&lt;/strong&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-- Average requests per second → 40 million / 86,400&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;=&amp;gt; &lt;strong data-start=&quot;900&quot; data-end=&quot;922&quot;&gt;&amp;nbsp;460 requests/sec (Approx)&lt;/strong&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-- Assuming peak traffic is &lt;strong data-start=&quot;960&quot; data-end=&quot;974&quot;&gt;5× average&lt;/strong&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;=&amp;gt; 460 × 5&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;=&amp;gt; &lt;strong data-start=&quot;1041&quot; data-end=&quot;1070&quot;&gt;2,300 requests/sec peak (Approx)&lt;/strong&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;strong data-start=&quot;1041&quot; data-end=&quot;1070&quot;&gt;&lt;br&gt;&lt;/strong&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;p data-start=&quot;1080&quot; data-end=&quot;1165&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-- &lt;strong data-start=&quot;1083&quot; data-end=&quot;1100&quot;&gt;Video storage&lt;/strong&gt;&lt;br&gt;-- 10,000 movies × 5 GB&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;=&amp;gt; &lt;strong data-start=&quot;1156&quot; data-end=&quot;1165&quot;&gt;50 TB&lt;/strong&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1167&quot; data-end=&quot;1233&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-- 5,000 TV seasons × 10 GB&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;=&amp;gt; &lt;strong data-start=&quot;1224&quot; data-end=&quot;1233&quot;&gt;50 TB&lt;/strong&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1235&quot; data-end=&quot;1299&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-- Total = 50 TB + 50 TB&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;=&amp;gt; &lt;strong data-start=&quot;1289&quot; data-end=&quot;1299&quot;&gt;100 TB&lt;/strong&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1301&quot; data-end=&quot;1386&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-- 3 copies for reliability → 100 × 3&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;=&amp;gt; &lt;strong data-start=&quot;1368&quot; data-end=&quot;1386&quot;&gt;300 TB storage&lt;/strong&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1396&quot; data-end=&quot;1494&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-- &lt;strong data-start=&quot;1399&quot; data-end=&quot;1424&quot;&gt;User database storage&lt;/strong&gt;&lt;br&gt;-- 10 million users x 10 KB&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;=&amp;gt; &lt;strong data-start=&quot;1484&quot; data-end=&quot;1494&quot;&gt;100 GB&lt;/strong&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1496&quot; data-end=&quot;1589&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-- Including watch history, preferences, etc.&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;=&amp;gt;&lt;strong data-start=&quot;1571&quot; data-end=&quot;1589&quot;&gt;&amp;nbsp;1–2 TB total (Approx)&lt;/strong&gt;&lt;/font&gt;&lt;/p&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="845" width="940" x="425" y="531" as="geometry" />
        </mxCell>
        <mxCell id="vhEXy31nvLbs3CA7Y5Pb-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;align=center;fillColor=#f5f5f5;strokeColor=#666666;gradientColor=#b3b3b3;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;Database Information&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-- Relational database (PostgreSQL/MySQL)&lt;br&gt;-- ACID compliant for reliable and consistent transactions&lt;br&gt;&lt;br&gt;-- Main database tables:&lt;br&gt;&amp;nbsp; &amp;nbsp;-- Users -&amp;gt; user_id, email, password_hash, created_at&lt;br&gt;&amp;nbsp; &amp;nbsp;-- Movies/Shows -&amp;gt; movie_id, title, genre, description, release_date&lt;br&gt;&amp;nbsp; &amp;nbsp;-- Watch History -&amp;gt; user_id, movie_id, watched_at, progress&lt;br&gt;&amp;nbsp; &amp;nbsp;-- Watchlist -&amp;gt; user_id, movie_id, added_at&lt;br&gt;&amp;nbsp; &amp;nbsp;-- Ratings -&amp;gt; user_id, movie_id, rating&lt;br&gt;&amp;nbsp; &amp;nbsp;-- Recommendations -&amp;gt; user_id, movie_id, recommendation_score&lt;br&gt;&amp;nbsp; &amp;nbsp;-- Sessions -&amp;gt; session_id, user_id, expiry_time&lt;br&gt;&lt;br&gt;-- Database relationships:&lt;br&gt;&amp;nbsp; &amp;nbsp;-- User -&amp;gt; Watch History = 1-to-many&lt;br&gt;&amp;nbsp; &amp;nbsp;-- User -&amp;gt; Ratings = 1-to-many&lt;br&gt;&amp;nbsp; &amp;nbsp;-- User &amp;lt;-&amp;gt; Movies/Shows = many-to-many&lt;br&gt;&amp;nbsp; &amp;nbsp;-- Movies/Shows &amp;lt;-&amp;gt; Genres = many-to-many&lt;br&gt;&lt;br&gt;-- Estimated user database storage:&lt;br&gt;&amp;nbsp; &amp;nbsp;-- 10 million users × 10 KB/user&lt;br&gt;&amp;nbsp; &amp;nbsp;-&amp;gt; ~100 GB&lt;br&gt;&lt;br&gt;-- Watch history, preferences, ratings, etc.&lt;br&gt;&amp;nbsp; &amp;nbsp;-&amp;gt; ~1–2 TB total database storage&lt;br&gt;&lt;br&gt;-- Database scaling:&lt;br&gt;&amp;nbsp; &amp;nbsp;-- Primary database handles writes&lt;br&gt;&amp;nbsp; &amp;nbsp;-- Read replicas handle high read traffic&lt;br&gt;&amp;nbsp; &amp;nbsp;-- Partition large Watch History table&lt;br&gt;&amp;nbsp; &amp;nbsp;-- Index user_id, movie_id, email, genre&lt;br&gt;&lt;br&gt;-- Reliability:&lt;br&gt;&amp;nbsp; &amp;nbsp;-- 3× database replication&lt;br&gt;&amp;nbsp; &amp;nbsp;-- Automated backups + point-in-time recovery&lt;br&gt;&lt;br&gt;-- Video files are stored in object storage/CDN&lt;br&gt;&amp;nbsp; &amp;nbsp;-- Database stores only video metadata and IDs&lt;/font&gt;" vertex="1">
